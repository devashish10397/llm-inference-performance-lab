{
  "metadata": {
    "name": "gpt2-rtx3050ti-optimization",
    "hardware": {
      "gpu": "NVIDIA GeForce RTX 3050 Ti Laptop GPU",
      "gpu_vram_mib": 4095.5,
      "cpu": "AMD Ryzen 9 5900HS with Radeon Graphics",
      "cpu_cores_threads": "8C/16T",
      "ram_gib": 15.41,
      "nvidia_driver": "560.94",
      "platform": "Windows 11 + WSL2 Ubuntu 24.04.5",
      "vllm": "0.8.5.post1",
      "torch": "2.6.0+cu124",
      "cuda_runtime": "12.4"
    }
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "http://127.0.0.1:8000",
      "model": "openai-community/gpt2",
      "request_format": "/v1/completions"
    },
    "profile": {
      "kind": "concurrent",
      "streams": [
        1,
        2,
        4,
        8
      ]
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 128,
        "output_tokens": 32
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 120
      }
    ]
  },
  "benchmarks": []
}

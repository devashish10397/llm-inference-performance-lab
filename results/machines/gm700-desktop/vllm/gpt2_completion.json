{
  "metadata": {
    "name": "gm700-gpt2-completions"
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "http://127.0.0.1:8000",
      "model": "openai-community/gpt2",
      "request_format": "/v1/completions"
    },
    "profile": {
      "kind": "concurrent",
      "streams": [1, 2, 4, 8, 16]
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 128,
        "output_tokens": 32
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 120
      }
    ],
    "outputs": [
      {
        "kind": "json",
        "path": "/mnt/c/Users/devis/Downloads/repos/llm-inference-performance-lab/results/machines/gm700-desktop/vllm/benchmarks.json"
      },
      {
        "kind": "csv",
        "path": "/mnt/c/Users/devis/Downloads/repos/llm-inference-performance-lab/results/machines/gm700-desktop/vllm/benchmarks.csv"
      }
    ]
  },
  "benchmarks": []
}

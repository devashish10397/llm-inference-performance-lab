{
  "metadata": {
    "name": "vllm-smoke"
  },
  "spec": {
    "backend": {
      "kind": "openai_http",
      "target": "http://127.0.0.1:8000",
      "model": "Qwen/Qwen2.5-0.5B-Instruct",
      "request_format": "/v1/chat/completions"
    },
    "profile": {
      "kind": "concurrent",
      "streams": [1, 2, 4, 8, 16]
    },
    "data": [
      {
        "kind": "synthetic_text",
        "prompt_tokens": 128,
        "output_tokens": 32
      }
    ],
    "constraints": [
      {
        "kind": "max_duration",
        "seconds": 120
      }
    ]
  },
  "benchmarks": []
}
